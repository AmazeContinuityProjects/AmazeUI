{
  "name": "@amazecontinuityprojects/amazeui",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "version": "1.6.1",
  "description": "The design library for AmazeCC",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./tailwind.css": "./dist/tailwind.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pkg:check": "publint && attw --pack . --exclude-entrypoints ./tailwind.css",
    "audit": "pnpm audit --prod --audit-level high",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmazeContinuityProjects/AmazeUI.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AmazeContinuityProjects/AmazeUI/issues"
  },
  "homepage": "https://github.com/AmazeContinuityProjects/AmazeUI#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-native": "^0.72.8",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@tailwindcss/typography": "^0.5.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "esbuild": "^0.28.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.23.0",
    "lucide-react-native": "^1.23.0",
    "nativewind": "^5.0.0-preview.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-circular-progressbar": "^2.2.0",
    "react-dom": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-css": "^3.0.7",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1"
  }
}
