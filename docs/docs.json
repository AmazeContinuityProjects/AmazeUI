{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AmazeUI",
  "description": "Developer handbook for the AmazeCC React component library.",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#3730A3"
  },
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"],
    "display": "header"
  },
  "markdown": {
    "instructions": "Write for junior React developers who know HTML. Explain JSX, TypeScript, state ownership, Tailwind CSS, and package exports. Verify names, defaults, and behavior against src/index.ts and component source. Do not claim native mobile support, data fetching, persistence, or runtime setup without source evidence. Always explain the tailwind.css entrypoint and caller responsibilities."
  },
